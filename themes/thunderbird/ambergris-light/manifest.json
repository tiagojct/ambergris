{
  "manifest_version": 2,
  "name": "Ambergris Light",
  "version": "0.2.0",
  "description": "Near-monochrome system on a cool grey ramp. One teal accent, restricted to interactive state. A five-stop hue sweep reserved for data, never for interface meaning.",
  "author": "Ambergris",
  "browser_specific_settings": {
    "gecko": {
      "id": "ambergris-light@ambergris.theme",
      "strict_min_version": "115.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#eaedef",
      "frame_inactive": "#eaedef",
      "toolbar": "#f3f5f7",
      "tab_selected": "#f3f5f7",
      "tab_text": "#1a1f26",
      "tab_background_text": "#5c6168",
      "tab_background_separator": "#dcdfe3",
      "tab_line": "#1e807b",
      "toolbar_text": "#1a1f26",
      "bookmark_text": "#1a1f26",
      "toolbar_top_separator": "#dcdfe3",
      "toolbar_bottom_separator": "#dcdfe3",
      "toolbar_vertical_separator": "#dcdfe3",
      "toolbar_field_separator": "#dcdfe3",
      "toolbar_field": "#fafbfd",
      "toolbar_field_text": "#1a1f26",
      "toolbar_field_border": "#c8cbd0",
      "toolbar_field_focus": "#fafbfd",
      "toolbar_field_text_focus": "#1a1f26",
      "toolbar_field_border_focus": "#0c1117",
      "toolbar_field_highlight": "#c9e5e5",
      "toolbar_field_highlight_text": "#1a1f26",
      "popup": "#fafbfd",
      "popup_text": "#1a1f26",
      "popup_border": "#c8cbd0",
      "popup_highlight": "#deeeef",
      "popup_highlight_text": "#1a1f26",
      "sidebar": "#f3f5f7",
      "sidebar_text": "#1a1f26",
      "sidebar_border": "#dcdfe3",
      "sidebar_highlight": "#1e807b",
      "sidebar_highlight_text": "#fafbfd",
      "icons": "#5c6168",
      "icons_attention": "#1e807b",
      "button_background_hover": "#eceef0",
      "button_background_active": "#e5e7ea",
      "sidebar_highlight_border": "#2f9f99"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "auto"
    }
  }
}
