      "toolbar_vertical_separator": "#2b3037",
      "toolbar_field_separator": "#2b3037",
      "toolbar_field": "#0c1117",
      "toolbar_field_text": "#eaedef",
      "toolbar_field_border": "#42484e",
      "toolbar_field_focus": "#0c1117",
      "toolbar_field_text_focus": "#eaedef",
      "toolbar_field_border_focus": "#fafbfd",
      "toolbar_field_highlight": "#143336",
