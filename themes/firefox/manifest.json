      "popup": "#fafbfd",
      "popup_text": "#1a1f26",
      "popup_border": "#c8cbd0",
      "popup_highlight": "#deeeef",
      "popup_highlight_text": "#1a1f26",
      "sidebar": "#f3f5f7",
      "sidebar_text": "#1a1f26",
      "sidebar_border": "#dcdfe3",
      "sidebar_highlight": "#1e807b",
      "sidebar_highlight_text": "#fafbfd",
      "icons": "#5c6168",
      "icons_attention": "#1e807b",
      "button_background_hover": "#eceef0",
      "button_background_active": "#e5e7ea",
      "ntp_background": "#fafbfd",
      "ntp_text": "#1a1f26",
      "ntp_card_background": "#f3f5f7"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "auto"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#0c1117",
      "frame_inactive": "#0c1117",
      "toolbar": "#1a1f26",
      "tab_selected": "#1a1f26",
