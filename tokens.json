  "terminal": {
    "comment": "Achromatic ANSI. Six hue slots collapse onto six luminance steps, ordered by how loudly each conventionally speaks: red, green, yellow, blue, magenta, cyan. Only about eight ramp steps clear 3:1 on a given canvas, so twelve chromatic slots cannot all be distinct. The bright hues therefore repeat their normal counterparts rather than shifting one step: offsetting them would land bright-green exactly on red and make success read as failure. Brightness is left to the terminal's own bold rendering. bright-black and bright-white stay separate, since those are the de-emphasis and emphasis slots. Programs that lean on hue alone still lose information here, so keep git's +/- prefixes and ls -F classifiers on.",
    "light": {
      "black":          "{color.grey.1000}",
      "red":            "{color.grey.950}",
      "green":          "{color.grey.900}",
      "yellow":         "{color.grey.800}",
      "blue":           "{color.grey.700}",
      "magenta":        "{color.grey.600}",
      "cyan":           "{color.grey.500}",
      "white":          "{color.grey.300}",
      "bright-black":   "{color.grey.400}",
      "bright-red":     "{color.grey.950}",
