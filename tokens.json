  "status": {
    "comment": "Unchanged from 0.1.0 and deliberately colourless. An accent exists now, but severity must never depend on it.",
    "neutral":  { "weight": "{border.width.hair}",  "edge": "solid",  "fill": "{color.alpha.ink.03}", "accent": "{color.grey.500}",  "icon": "dot" },
    "success":  { "weight": "{border.width.thin}",  "edge": "solid",  "fill": "{color.alpha.ink.03}", "accent": "{color.grey.700}",  "icon": "check" },
    "warning":  { "weight": "{border.width.thin}",  "edge": "dashed", "fill": "{color.alpha.ink.06}", "accent": "{color.grey.800}",  "icon": "triangle" },
    "critical": { "weight": "{border.width.thick}", "edge": "solid",  "fill": "{color.alpha.ink.10}", "accent": "{color.grey.1000}", "icon": "octagon" }
  },

  "border": {
    "width": { "hair": "1px", "thin": "1.5px", "thick": "3px" },
    "radius": { "none": "0", "sm": "3px", "md": "6px", "lg": "10px", "full": "999px" }
  },

  "focus": {
    "comment": "Stays achromatic. Accent marks what is current; focus marks where the keyboard is. Different questions, and focus must survive on every surface in both ramps.",
    "width": "2px",
    "offset": "2px"
  },

  "shadow": {
    "0": "none",
    "1": "0 1px 2px {color.alpha.ink.06}",
    "2": "0 1px 2px {color.alpha.ink.06}, 0 4px 8px -2px {color.alpha.ink.06}",
    "3": "0 2px 4px {color.alpha.ink.06}, 0 12px 24px -6px {color.alpha.ink.10}",
    "inset": "inset 0 1px 0 {color.alpha.paper.64}"
  }
}
