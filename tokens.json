      "fill-solid":        "{color.grey.100}",
      "fill-solid-hover":  "{color.grey.000}",
      "fill-muted":        "{color.grey.900}",
      "fill-muted-hover":  "{color.grey.800}",

      "link":                 "{color.accent.400}",
      "link-hover":           "{color.accent.300}",
      "accent-line":          "{color.accent.500}",
      "accent-surface":       "{color.accent.900}",
      "accent-surface-hover": "{color.accent.800}",
      "accent-on-surface":    "{color.accent.300}",
