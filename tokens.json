{
  "meta": {
    "name": "Ambergris",
    "version": "0.2.0",
    "description": "Near-monochrome system on a cool grey ramp. One teal accent, restricted to interactive state. A five-stop hue sweep reserved for data, never for interface meaning.",
    "prefix": "am",
    "author": "Ambergris",
    "greyHue": 254,
    "accentHue": 190,
    "rules": [
      "Accent marks interaction only: links, current item, selection, accent rules. Never severity, never decoration.",
      "Status is achromatic. Severity is carried by border weight, edge style and fill density, plus an icon and explicit copy.",
      "The data sweep never appears in interface chrome, and the interface accent never appears in a chart."
    ]
  },

