      "text-primary":      "{color.grey.950}",
      "text-secondary":    "{color.grey.700}",
      "text-tertiary":     "{color.grey.600}",
      "text-disabled":     "{color.grey.400}",
      "text-inverse":      "{color.grey.000}",
