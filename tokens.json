{
  "meta": {
    "name": "Ambergris",
    "version": "0.3.0",
    "description": "Near-monochrome system on a cool grey ramp. One teal accent, restricted to interactive state. A five-stop hue sweep reserved for data, never for interface meaning.",
    "prefix": "am",
    "greyHue": 254,
    "accentHue": 190,
    "rules": [
      "Accent marks interaction only: links, current item, selection, accent rules. Never severity, never decoration.",
      "Status is achromatic. Severity is carried by border weight, edge style and fill density, plus an icon and explicit copy.",
      "The data sweep never appears in interface chrome, and the interface accent never appears in a chart.",
      "Functional hues exist for terminal and editor content only: ANSI slots, diffs, diagnostics. Never interface chrome."
    ]
  },

  "color": {
    "grey": {
      "000":  { "hex": "#FAFBFD", "oklch": "oklch(0.988 0.0025 254)" },
      "050":  { "hex": "#F3F5F7", "oklch": "oklch(0.968 0.0035 254)" },
      "100":  { "hex": "#EAEDEF", "oklch": "oklch(0.944 0.0045 254)" },
      "200":  { "hex": "#DCDFE3", "oklch": "oklch(0.902 0.0060 254)" },
      "300":  { "hex": "#C8CBD0", "oklch": "oklch(0.842 0.0075 254)" },
      "400":  { "hex": "#AEB2B7", "oklch": "oklch(0.762 0.0090 254)" },
      "500":  { "hex": "#8D9298", "oklch": "oklch(0.658 0.0105 254)" },
      "600":  { "hex": "#72777D", "oklch": "oklch(0.566 0.0115 254)" },
      "700":  { "hex": "#5C6168", "oklch": "oklch(0.492 0.0125 254)" },
      "800":  { "hex": "#42484E", "oklch": "oklch(0.398 0.0135 254)" },
      "900":  { "hex": "#2B3037", "oklch": "oklch(0.308 0.0140 254)" },
      "950":  { "hex": "#1A1F26", "oklch": "oklch(0.238 0.0145 254)" },
      "1000": { "hex": "#0C1117", "oklch": "oklch(0.176 0.0150 254)" }
    },

    "accent": {
      "comment": "Hue 190, 64 degrees off the grey ramp so it never reads as a saturated grey. Chroma is pulled back below L 0.55 to stay inside sRGB. Derived from the teal end of the supplied sweep, the only end that clears 3:1 on both grounds.",
      "050": { "hex": "#E7F8F6", "oklch": "oklch(0.965 0.018 190)" },
      "100": { "hex": "#D1EFEC", "oklch": "oklch(0.930 0.032 190)" },
      "200": { "hex": "#AEE0DC", "oklch": "oklch(0.870 0.052 190)" },
      "300": { "hex": "#86CDC8", "oklch": "oklch(0.800 0.072 190)" },
      "400": { "hex": "#5BB6B1", "oklch": "oklch(0.720 0.088 190)" },
      "500": { "hex": "#2F9F99", "oklch": "oklch(0.640 0.098 190)" },
      "600": { "hex": "#1E807B", "oklch": "oklch(0.545 0.086 190)" },
      "700": { "hex": "#1B6864", "oklch": "oklch(0.470 0.072 190)" },
      "800": { "hex": "#164F4C", "oklch": "oklch(0.390 0.058 190)" },
      "900": { "hex": "#0E3937", "oklch": "oklch(0.315 0.046 190)" }
    },

    "alpha": {
      "ink": {
        "03": "rgb(12 17 23 / 0.03)",
        "06": "rgb(12 17 23 / 0.06)",
        "10": "rgb(12 17 23 / 0.10)",
        "16": "rgb(12 17 23 / 0.16)",
        "28": "rgb(12 17 23 / 0.28)",
        "56": "rgb(12 17 23 / 0.56)",
        "72": "rgb(12 17 23 / 0.72)"
      },
      "paper": {
        "04": "rgb(250 251 253 / 0.04)",
        "08": "rgb(250 251 253 / 0.08)",
        "12": "rgb(250 251 253 / 0.12)",
        "20": "rgb(250 251 253 / 0.20)",
        "36": "rgb(250 251 253 / 0.36)",
        "64": "rgb(250 251 253 / 0.64)"
      },
      "accent": {
        "08": "rgb(47 159 153 / 0.08)",
        "14": "rgb(47 159 153 / 0.14)",
        "24": "rgb(47 159 153 / 0.24)"
      }
    }
  },

  "data": {
    "comment": "Sequential scales only. Analogous hues cannot be told apart reliably enough for categorical encoding, so never use these for unordered groups. Adjacent steps clear 1.2:1 in both variants, the practical floor for touching areas in a chart. Pick the variant matching the chart background, not the page theme.",
    "hue-path": [185.4, 219.6, 251.8, 267.8, 276.4],
    "supplied": ["#26998E", "#26859E", "#2664A3", "#263FA9", "#3426AE"],
    "sequence-on-light": {
      "1": { "hex": "#2EA094", "oklch": "oklch(0.640 0.100 185.4)" },
      "2": { "hex": "#0587A4", "oklch": "oklch(0.578 0.104 219.6)" },
      "3": { "hex": "#236AAF", "oklch": "oklch(0.516 0.130 251.8)" },
      "4": { "hex": "#304BB0", "oklch": "oklch(0.454 0.165 267.8)" },
      "5": { "hex": "#3428AA", "oklch": "oklch(0.392 0.195 276.4)" }
    },
    "sequence-on-dark": {
      "1": { "hex": "#13998D", "oklch": "oklch(0.615 0.105 185.4)" },
      "2": { "hex": "#2BA6C6", "oklch": "oklch(0.675 0.112 219.6)" },
      "3": { "hex": "#6FAEF3", "oklch": "oklch(0.735 0.120 251.8)" },
      "4": { "hex": "#A0BAFE", "oklch": "oklch(0.795 0.102 267.8)" },
      "5": { "hex": "#C3CCFE", "oklch": "oklch(0.855 0.070 276.4)" }
    }
  },

  "ansi": {
    "comment": "Functional hues for terminal and editor content: the 16 ANSI slots, diffs, diagnostics. Chroma is capped near the accent's (0.09-0.10) so a full screen of them still reads near-monochrome; cyan IS the accent. Tuned for dark grounds only. Not emitted to ambergris.css; consumed by the port emitters.",
    "black":          "{color.grey.950}",
    "red":            { "hex": "#CF7F79", "oklch": "oklch(0.680 0.100 25)" },
    "green":          { "hex": "#7BB587", "oklch": "oklch(0.720 0.090 150)" },
    "yellow":         { "hex": "#D4BC79", "oklch": "oklch(0.800 0.090 90)" },
    "blue":           { "hex": "#72A5DE", "oklch": "oklch(0.710 0.100 252)" },
    "magenta":        { "hex": "#B893D4", "oklch": "oklch(0.720 0.100 310)" },
    "cyan":           "{color.accent.400}",
    "white":          "{color.grey.300}",
    "bright-black":   "{color.grey.700}",
    "bright-red":     { "hex": "#E7958E", "oklch": "oklch(0.750 0.100 25)" },
    "bright-green":   { "hex": "#91CB9C", "oklch": "oklch(0.790 0.090 150)" },
    "bright-yellow":  { "hex": "#E8CF8C", "oklch": "oklch(0.860 0.090 90)" },
    "bright-blue":    { "hex": "#88BCF6", "oklch": "oklch(0.780 0.100 252)" },
    "bright-magenta": { "hex": "#CEA9EB", "oklch": "oklch(0.790 0.100 310)" },
    "bright-cyan":    "{color.accent.300}",
    "bright-white":   "{color.grey.000}"
  },

  "contrast": {
    "assert": [
      { "fg": "{color.grey.950}",   "bg": "{color.grey.000}",  "min": 7,   "why": "body text, light" },
      { "fg": "{color.grey.700}",   "bg": "{color.grey.000}",  "min": 4.5, "why": "secondary text, light" },
      { "fg": "{color.grey.500}",   "bg": "{color.grey.000}",  "min": 3,   "why": "input borders, light" },
      { "fg": "{color.grey.100}",   "bg": "{color.grey.1000}", "min": 7,   "why": "body text, dark" },
      { "fg": "{color.grey.500}",   "bg": "{color.grey.1000}", "min": 4.5, "why": "tertiary text, dark" },
      { "fg": "{color.accent.600}", "bg": "{color.grey.000}",  "min": 4.5, "why": "link, light" },
      { "fg": "{color.accent.700}", "bg": "{color.grey.000}",  "min": 4.5, "why": "link hover, light" },
      { "fg": "{color.accent.400}", "bg": "{color.grey.950}",  "min": 4.5, "why": "link, dark" },
      { "fg": "{color.accent.300}", "bg": "{color.grey.950}",  "min": 4.5, "why": "link hover, dark" },
      { "fg": "{color.accent.500}", "bg": "{color.grey.000}",  "min": 3,   "why": "accent rule, light" },
      { "fg": "{color.accent.500}", "bg": "{color.grey.1000}", "min": 3,   "why": "accent rule, dark" },
      { "fg": "{ansi.red}",            "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi red, dark" },
      { "fg": "{ansi.green}",          "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi green, dark" },
      { "fg": "{ansi.yellow}",         "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi yellow, dark" },
      { "fg": "{ansi.blue}",           "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi blue, dark" },
      { "fg": "{ansi.magenta}",        "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi magenta, dark" },
      { "fg": "{ansi.cyan}",           "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi cyan, dark" },
      { "fg": "{ansi.bright-red}",     "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright red, dark" },
      { "fg": "{ansi.bright-green}",   "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright green, dark" },
      { "fg": "{ansi.bright-yellow}",  "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright yellow, dark" },
      { "fg": "{ansi.bright-blue}",    "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright blue, dark" },
      { "fg": "{ansi.bright-magenta}", "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright magenta, dark" },
      { "fg": "{ansi.bright-cyan}",    "bg": "{color.grey.1000}", "min": 4.5, "why": "ansi bright cyan, dark" }
    ]
  },

